<Project>

  <!-- Shared metadata and compiler settings for every project in the repo. -->
  <PropertyGroup>
    <Product>KSC.Observability</Product>
    <Company>KSC</Company>
    <Authors>KSC Platform Team</Authors>
    <Copyright>Copyright (c) KSC</Copyright>

    <!-- Semantic version, bumped per release. -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Quiet down XML-doc warnings for internal members. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Packaging defaults; only projects with IsPackable=true actually produce a .nupkg. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KSC/KSC.Observability</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KSC/KSC.Observability</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>observability;metrics;prometheus;monitoring;dotnet-framework;aspnet</PackageTags>
  </PropertyGroup>

</Project>
