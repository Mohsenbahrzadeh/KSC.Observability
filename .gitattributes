# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Source and config are LF in the repo.
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf

# Windows-native tooling expects CRLF.
*.sln       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.ico       binary
*.snk       binary
*.nupkg     binary
