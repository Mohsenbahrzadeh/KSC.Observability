{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ksc", "observability", "dotnet"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
        "definition": "label_values(ksc_build_info, service)",
        "query": { "query": "label_values(ksc_build_info, service)", "refId": "StandardVariableQuery" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "KSC.Observability — Overview",
  "uid": "ksc-observability-overview",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Active users (concurrent)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "sum(ksc_active_users{service=~\"$service\"})" } ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Requests in flight",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 } ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "sum(ksc_http_requests_in_flight{service=~\"$service\"})" } ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "sum(rate(ksc_http_requests_total{service=~\"$service\"}[5m]))" } ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto", "justifyMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "max(ksc_process_uptime_seconds{service=~\"$service\"})" } ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Traffic & latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Request rate by service",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "sum by (service) (rate(ksc_http_requests_total{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}" } ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Error rate (5xx) by service",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "showPoints": "never" }, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "sum by (service) (rate(ksc_http_requests_total{service=~\"$service\", code=~\"5..\"}[5m]))", "legendFormat": "{{service}}" } ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Request latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(ksc_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(ksc_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(ksc_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Process resources",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "CPU usage (% of one core)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "ksc_process_cpu_usage_percent{service=~\"$service\"}", "legendFormat": "{{service}} / {{instance}}" } ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Memory (working set)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "ksc_process_working_set_bytes{service=~\"$service\"}", "legendFormat": "working set — {{service}}/{{instance}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "ksc_process_managed_memory_bytes{service=~\"$service\"}", "legendFormat": "managed heap — {{service}}/{{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Threads & handles",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "ksc_process_threads{service=~\"$service\"}", "legendFormat": "threads — {{instance}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "ksc_process_handles{service=~\"$service\"}", "legendFormat": "handles — {{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "GC collections rate by generation",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PROMETHEUS" }, "expr": "sum by (generation) (rate(ksc_gc_collections_total{service=~\"$service\"}[5m]))", "legendFormat": "gen {{generation}}" } ]
    }
  ]
}
