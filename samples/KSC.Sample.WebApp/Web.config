<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!--
      Zero-code configuration. These are read automatically on the first request.
      Code in Global.asax (KscObservability.Initialize) can override them.
    -->
    <add key="KSC.Observability:ServiceName" value="sample-web-app" />
    <add key="KSC.Observability:Environment" value="development" />
    <add key="KSC.Observability:MetricsPath" value="/metrics" />
    <add key="KSC.Observability:EnableSystemMetrics" value="true" />
    <add key="KSC.Observability:EnableHttpMetrics" value="true" />
    <add key="KSC.Observability:EnableActiveUserTracking" value="true" />
    <add key="KSC.Observability:ActiveUserWindowSeconds" value="300" />
    <!-- <add key="KSC.Observability:MetricsAccessToken" value="super-secret" /> -->
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>

  <!--
    No <modules> entry is required: KSC.Observability.AspNet registers its HttpModule
    automatically via [assembly: PreApplicationStartMethod]. Shown here only for reference:

    <system.webServer>
      <modules>
        <add name="ObservabilityHttpModule"
             type="KSC.Observability.AspNet.ObservabilityHttpModule, KSC.Observability.AspNet" />
      </modules>
    </system.webServer>
  -->

</configuration>
