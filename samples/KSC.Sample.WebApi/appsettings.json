{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "KSC.Observability": {
    "ServiceName": "sample-web-api",
    "Environment": "development",
    "MetricsPath": "/metrics",
    "EnableSystemMetrics": true,
    "EnableHttpMetrics": true,
    "EnableActiveUserTracking": true,
    "TrackRequestPath": true,
    "ActiveUserWindow": "00:05:00"
  }
}
